{
  "manifest_version": 2,
  "id": "com.maibot.context-image",
  "version": "0.2.1",
  "name": "MaiBot Context Image",
  "description": "基于聊天上下文、固定人物身份参考图和 GPT Image 的智能生图插件。",
  "author": {
    "name": "MaiBot Context Image Contributors",
    "url": "https://github.com/2512855234"
  },
  "license": "Apache-2.0",
  "plugin_type": "media",
  "urls": {
    "repository": "https://github.com/2512855234/maibot-context-image",
    "documentation": "https://github.com/2512855234/maibot-context-image#readme"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "send.image",
    "message.get_recent",
    "message.build_readable",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
